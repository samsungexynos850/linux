 */

/dts-v1/;
#include "exynos850.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Samsung Galaxy A21s";
	compatible = "samsung,a217f", "samsung,exynos850";

	chosen {
		bootargs = "no_console_suspend mem_sleep_default=s2idle androidboot.hardware=exynos850 androidboot.boot_devices=soc@0/12100000.mmc androidboot.selinux=permissive androidboot.verifiedbootstate=orange androidboot.init_fatal_reboot_target=recovery firmware_class.path=/vendor/firmware/ log_buf_len=4M loop.max_part=7 rw";

	};

	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion-polymer";
		charge-full-design-microamp-hours = <5000000>;
		voltage-max-design-microvolt = <4350000>;
		alert-celsius = <0 50>;
	};

	/*
	 * RTC clock (XrtcXTI); external, must be 32.768 kHz.
	 *
	 * TODO: Remove this once RTC clock is implemented properly as part of
	 *       PMIC driver.
	 */
	rtcclk: clock-rtcclk {
		compatible = "fixed-clock";
		clock-output-names = "rtcclk";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown &key_volup>;
		pinctrl-names = "default";

		voldown-key {
			label = "Volume Down";
			gpios = <&gpa1 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		volup-key {
			label = "Volume Up";
			gpios = <&gpa0 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x3c900000>,
		      <0x0 0xc0000000 0x20000000>,
		      <0x0 0xe0d00000 0x1f300000>,
		      <0x8 0x80000000 0x20000000>,
		      <0x8 0xa0000000 0x20000000>;
	};

	/* TODO: Remove this once PMIC is implemented  */
	reg_dummy: regulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "dummy_reg";
	};

	reserved-memory {
		ranges;
		#address-cells = <2>;
		#size-cells = <1>;

		/*
		 * S-Boot rewrites its debug snapshot header at 0xf0000000
		 * (ess_setup), but keeps the kernel log area after it intact
		 */
		ramoops@f0010000 {
			compatible = "ramoops";
			reg = <0x0 0xf0010000 0x200000>;
			record-size = <0x20000>;
			console-size = <0x20000>;
			ftrace-size = <0x100000>;
			pmsg-size = <0x20000>;
		};

		/*
		 * Without the DPU IOMMU, scanout buffers are physically
		 * contiguous, and the DECON only takes 32-bit addresses
		 */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x10000000>;
			alloc-ranges = <0x0 0x80000000 0x80000000>;
			linux,cma-default;
		};

		/* Shared memory of the WLBT subsystem, holds its firmware */
		wlbt_mem: wlbt {
			size = <0xc00000>;
			alignment = <0x0 0x100000>;
			alloc-ranges = <0x0 0x80000000 0x80000000>;
			no-map;
		};

		cont_splash_mem: framebuffer@fa000000 {
			reg = <0x0 0xfa000000 (720 * 1600 * 4)>;
			/*
			 * Boot splash of the bootloader. The DECON keeps
			 * scanning it out until the first commit from userspace,
			 * so it stays identity mapped behind the IOMMU.
			 */
			iommu-addresses = <&decon 0xfa000000 (720 * 1600 * 4)>;
			no-map;
		};
	};
};

&acpm_ipc {
	pmic-1 {
		compatible = "samsung,s2mpu12-pmic";
		interrupts = <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-0 = <&pm_wrstbi>;
		pinctrl-names = "default";
		system-power-controller;
		wakeup-source;

		regulators {
			vdd_buck1: buck1 {
				regulator-name = "vdd_cpu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
			};

			vdd_buck2: buck2 {
				regulator-name = "vdd_gpu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
			};

			vdd_buck4: buck4 {
				regulator-name = "vdd_lldo";
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1500000>;
				regulator-always-on;
			};

			vdd_buck5: buck5 {
				regulator-name = "vdd_mldo";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <2100000>;
				regulator-always-on;
			};

			vdd_ldo1: ldo1 {
				regulator-name = "vdd_ldo1";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			vdd_ldo2: ldo2 {
				regulator-name = "vdd_ldo2";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
			};

			vdd_ldo3: ldo3 {
				regulator-name = "vdd_ldo3";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			vdd_ldo4: ldo4 {
				regulator-name = "vdd_ldo4";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
			};

			vdd_ldo5: ldo5 {
				regulator-name = "vdd_ldo5";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			vdd_ldo6: ldo6 {
				regulator-name = "vdd_ldo6";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1187500>;
				regulator-always-on;
			};

			vdd_ldo7: ldo7 {
				regulator-name = "vdd_ldo7";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			vdd_ldo8: ldo8 {
				regulator-name = "vdd_ldo8";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			vdd_ldo9: ldo9 {
				regulator-name = "vdd_ldo9";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			vdd_ldo10: ldo10 {
				regulator-name = "vqmmc";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <2950000>;
			};

			vdd_ldo11: ldo11 {
				regulator-name = "vdd_ldo11";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3375000>;
				regulator-always-on;
			};

			vdd_ldo23: ldo23 {
				regulator-name = "vdd_ldo23";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-always-on;
			};

			vdd_ldo24: ldo24 {
				regulator-name = "vmmc";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <2950000>;
			};

			vdd_ldo25: ldo25 {
				regulator-name = "vdd_ldo25";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-always-on;
			};

			vdd_ldo26: ldo26 {
				regulator-name = "vdd_btp_3p3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3375000>;
			};

			vdd_ldo27: ldo27 {
				regulator-name = "vdd_grip_3p0";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vdd_ldo28: ldo28 {
				regulator-name = "vdd_ldo28";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};

			vdd_ldo29: ldo29 {
				regulator-name = "vdd_ldo29";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1300000>;
			};

			vdd_ldo30: ldo30 {
				regulator-name = "vdd_ldo30";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
			};

			vdd_ldo31: ldo31 {
				regulator-name = "vdd_ldo31";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
			};

			vdd_ldo32: ldo32 {
				regulator-name = "vdd_ldo32";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
			};

			vdd_ldo33: ldo33 {
				regulator-name = "vdd_aldo1";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
			};

			vdd_ldo34: ldo34 {
				regulator-name = "vdd_aldo2";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-always-on;
			};

			vdd_ldo35: ldo35 {
				regulator-name = "vdd_ldo_core";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
			};

			vdd_ldo36: ldo36 {
				regulator-name = "vdd_ldo_buf";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1300000>;
			};
		};
	};
};

&adc {
	/* TODO: the analog supply is an always-on PMIC rail */
	vdd-supply = <&reg_dummy>;

	status = "okay";
};

&cmu_hsi {
	clocks = <&oscclk>, <&rtcclk>,
		 <&cmu_top CLK_DOUT_HSI_BUS>,
		 <&cmu_top CLK_DOUT_HSI_MMC_CARD>,
		 <&cmu_top CLK_DOUT_HSI_USB20DRD>;
	clock-names = "oscclk", "rtcclk", "dout_hsi_bus",
		      "dout_hsi_mmc_card", "dout_hsi_usb20drd";
};

&decon {
	memory-region = <&cont_splash_mem>;
	status = "okay";
};

&dsi {
	samsung,burst-clock-frequency = <830000000>;
	samsung,esc-clock-frequency = <20000000>;
	status = "okay";

	panel@0 {
		compatible = "syna,td4150-panel";
		reg = <0>;

		/*
		 * TODO: Add vsn-supply, vsp-supply and backlight-gpios
		 * (gpg2 1) once the LM36274 bias and backlight driver is
		 * described. Until then these keep the configuration of
		 * the bootloader.
		 */
		vio-supply = <&vdd_ldo28>;
		reset-gpios = <&gpg2 4 GPIO_ACTIVE_LOW>;

		width-mm = <69>;
		height-mm = <152>;

		panel-timing {
			clock-frequency = <128118000>;

			hactive = <720>;
			hfront-porch = <508>;
			hsync-len = <2>;
			hback-porch = <80>;

			vactive = <1600>;
			vfront-porch = <24>;
			vsync-len = <2>;
			vback-porch = <4>;
		};
	};
};

&gpu {
	mali-supply = <&vdd_buck2>;

	status = "okay";
};

&i2c_0 {
	status = "okay";

	pmic@3d {
		compatible = "samsung,s2mu106-pmic";
		reg = <0x3d>;
		pinctrl-0 = <&if_pmic_irq>;
		pinctrl-names = "default";

		interrupt-parent = <&gpa2>;
		interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
	};

	fuel-gauge@3b {
		compatible = "samsung,s2mu106-fuel-gauge";
		reg = <0x3b>;
		pinctrl-0 = <&fg_alert>;
		pinctrl-names = "default";

		interrupt-parent = <&gpa3>;
		interrupts = <0 IRQ_TYPE_EDGE_BOTH>;
		wakeup-source;

		monitored-battery = <&battery>;
		shunt-resistor-micro-ohms = <5000>;

		io-channels = <&adc 1>;
		io-channel-names = "temp";
		samsung,temp-lookup-table =
			<90000 311>,
			<85000 349>,
			<80000 403>,
			<75000 478>,
			<70000 565>,
			<65000 670>,
			<60000 781>,
			<55000 910>,
			<50000 1047>,
			<45000 1220>,
			<40000 1382>,
			<35000 1615>,
			<30000 1841>,
			<25000 2059>,
			<20000 2285>,
			<15000 2499>,
			<10000 2747>,
			<5000 2950>,
			<0 3159>,
			<(-5000) 3307>,
			<(-10000) 3475>,
			<(-15000) 3604>,
			<(-20000) 3690>;

		/* Samsung SDI model, first age step of the downstream data */
		samsung,battery-capacity = /bits/ 8 <0xc4 0x49 0xc0 0x0e>;
		samsung,battery-model = /bits/ 8 <
			0xf8 0x0a 0x75 0x0a 0xf2 0x09 0x80 0x09 0x13 0x09 0xab
			0x08 0x49 0x08 0xd0 0x07 0x9c 0x07 0x46 0x07 0xe6 0x06
			0xac 0x06 0x82 0x06 0x61 0x06 0x47 0x06 0x2d 0x06 0x07
			0x06 0xdf 0x05 0x9b 0x05 0x82 0x05 0x98 0x04 0x9c 0x01
			0x6a 0x08 0x00 0x08 0x96 0x07 0x2c 0x07 0xc2 0x06 0x58
			0x06 0xee 0x05 0x84 0x05 0x1a 0x05 0xb1 0x04 0x47 0x04
			0xdd 0x03 0x73 0x03 0x09 0x03 0x9f 0x02 0x35 0x02 0xcb
			0x01 0x61 0x01 0xf7 0x00 0x8d 0x00 0x23 0x00 0xe3 0x0f
			0x0a 0x0a 0x0a 0x0a 0x33 0x33 0x33 0x34 0x33 0x33 0x33
			0x33 0x34 0x34 0x34 0x35 0x36 0x37 0x39 0x3c 0x41 0x9a
		>;
	};
};

&i2c_5 {
	status = "okay";

	pmic@56 {
		compatible = "samsung,s2mpb03";
		reg = <0x56>;

		regulators {
			ldo1 {
				regulator-name = "cam0_vldo1";
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
			};

			ldo2 {
				regulator-name = "cam0_vldo2";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
			};

			ldo3 {
				regulator-name = "cam0_vldo3";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			ldo4 {
				regulator-name = "cam0_vldo4";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
			};

			ldo5 {
				regulator-name = "cam0_vldo5";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			ldo6 {
				regulator-name = "cam0_vldo6";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			ldo7 {
				regulator-name = "cam0_vldo7";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};
		};
	};
};

&mmc_0 {
	compatible = "samsung,exynos7-dw-mshc";
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	cap-mmc-highspeed;
	non-removable;
	mmc-hs400-enhanced-strobe;
	card-detect-delay = <200>;
	clock-frequency = <800000000>;
	bus-width = <8>;

	pinctrl-0 = <&sd0_clk_pins &sd0_cmd_pins &sd0_rdqs_pins &sd0_nreset_pins
		     &sd0_bus1_pins &sd0_bus4_pins &sd0_bus8_pins>;
	pinctrl-names = "default";

	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 4>;
	samsung,dw-mshc-ddr-timing = <2 4>;
	samsung,dw-mshc-hs400-timing = <0 2>;

	status = "okay";
};

&oscclk {
	clock-frequency = <26000000>;
};

&pinctrl_alive {
	if_pmic_irq: if-pmic-irq-pins {
		samsung,pins = "gpa2-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	fg_alert: fg-alert-pins {
		samsung,pins = "gpa3-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa1-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa0-7";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
	};
};

&pinctrl_peri {
	/* Warm reset input of the PMIC, kept high */
	pm_wrstbi: pm-wrstbi-pins {
		samsung,pins = "gpg1-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
	};
};

&rtc {
	clocks = <&cmu_apm CLK_GOUT_RTC_PCLK>, <&rtcclk>;
	clock-names = "rtc", "rtc_src";

	status = "disabled";
};

&spi_1 {
	cs-gpios = <&gpm3 0 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	touchscreen@0 {
		compatible = "syna,td4150-touchscreen";
		reg = <0>;
		interrupt-parent = <&gpa0>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		spi-max-frequency = <7000000>;
		spi-cpha;
		spi-cpol;
		wakeup-source;
	};
};

&timer {
	/*
	 * Non-updatable, broken stock Samsung bootloader does not
	 * configure CNTFRQ_EL0
	 */
	clock-frequency = <26000000>;
};

&usbdrd {
	vdd10-supply = <&reg_dummy>;
	vdd33-supply = <&reg_dummy>;

	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "otg";
	maximum-speed = "high-speed";
};

&usbdrd_phy {
	status = "okay";
};

&usi_cmgp0 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&watchdog_cl0 {
	status = "okay";
};

&watchdog_cl1 {
	status = "okay";
};

&wlbt {
	memory-region = <&wlbt_mem>;
	status = "okay";
};
